{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "firetrident",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "firetrident.com", "custom_domain": true },
    { "pattern": "www.firetrident.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api", "/api/*", "/mcp", "/mcp/*", "/public/mcp", "/sse", "/sse/*", "/healthz", "/git/*", "/.well-known/firetrident-keys.json", "/.well-known/firetrident-allowed-signers", "/auth/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "COLONY", "class_name": "ColonyDO" },
      { "name": "REGION", "class_name": "RegionDO" },
      { "name": "TRUNK", "class_name": "TrunkDO" },
      { "name": "POOL", "class_name": "PoolDO" },
      { "name": "AGENT", "class_name": "AgentDO" },
      { "name": "MCP", "class_name": "FireTridentMcp" },
      { "name": "ACCOUNTS", "class_name": "AccountsDO" },
      { "name": "CF_GRANTS", "class_name": "CloudflareGrantDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ColonyDO", "RegionDO", "TrunkDO", "PoolDO", "AgentDO", "FireTridentMcp"] },
    { "tag": "v2", "new_sqlite_classes": ["AccountsDO", "CloudflareGrantDO"] }
  ],
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "ft-trunk" },
    { "binding": "WS0", "namespace": "ft-ws-0" },
    { "binding": "WS1", "namespace": "ft-ws-1" },
    { "binding": "WS2", "namespace": "ft-ws-2" },
    { "binding": "WS3", "namespace": "ft-ws-3" },
    { "binding": "SESSIONS", "namespace": "ft-sessions" }
  ],
  "ai": { "binding": "AI" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "worker_loaders": [{ "binding": "LOADER" }],
  "workflows": [
    { "name": "ft-ingest", "binding": "INGEST", "class_name": "IngestWorkflow" },
    { "name": "ft-verify", "binding": "VERIFY", "class_name": "VerifyWorkflow" }
  ],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "firetrident_metrics" }],
  "ratelimits": [
    { "name": "PUBLIC_IP_LIMIT", "namespace_id": "41001", "simple": { "limit": 1200, "period": 60 } },
    { "name": "PUBLIC_COLONY_LIMIT", "namespace_id": "41002", "simple": { "limit": 3000, "period": 60 } }
  ],
  "vars": { "FT_PUBLIC_URL": "https://firetrident.com", "FT_DEFAULT_MODEL": "@cf/moonshotai/kimi-k2.7-code", "FT_BULK_MODEL": "@cf/google/gemma-4-26b-a4b-it", "FT_REFLEX_MODEL": "@cf/cloudflare/clef", "FT_COCHANGE_WEIGHT": "5", "FT_PUBLIC_GIT": "hono,shortlinks,byo-demo,scale,order-backend,signed-notes,first-red", "FT_TRUNK_TESTS": "on", "FT_INLINE": "on", "FT_VIRTUAL_CHECKOUT": "on", "FT_CULPRITS": "on", "FT_BISECT": "on", "FT_DELETION_GUARD": "on", "FT_TEXT_MERGE": "on", "FT_PUBLIC_MCP": "hono,shortlinks,byo-demo,scale,order-backend,signed-notes,first-red", "FT_GOAL_CONFLICT": "on", "FT_MEGAFILE": "on", "FT_FIELD_GUIDE": "on", "FT_RESOLVER": "on", "FT_AGENT_CALL_BUDGET": "on", "FT_MERGE_INSERTIONS": "on", "FT_MODEL_STEPUP": "on", "FT_TWINS": "on", "FT_QUOTED_ACCEPTANCE": "on", "FT_A2A": "on", "FT_INTENT_SPEND": "on", "FT_HEDGE": "on", "FT_RETURN_HUNKS": "on", "FT_LESSON_SCOPE": "on", "FT_HEADS_UP": "on", "FT_CREDIT_TRAILERS": "on", "FT_REPRODUCE": "on", "FT_ESCALATION_BATCH": "on", "FT_PERSON_WAIT": "on", "FT_ALREADY_ON_TRUNK": "on" },
  "env": {
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.firetrident.com", "custom_domain": true }],
      "vars": { "FT_PUBLIC_URL": "https://staging.firetrident.com", "FT_DEFAULT_MODEL": "@cf/moonshotai/kimi-k2.7-code", "FT_BULK_MODEL": "@cf/google/gemma-4-26b-a4b-it", "FT_REFLEX_MODEL": "@cf/cloudflare/clef", "FT_COCHANGE_WEIGHT": "5", "FT_PUBLIC_GIT": "hono,shortlinks,byo-demo,scale,order-backend,signed-notes,first-red,mosaic,rename,smuggle", "FT_TRUNK_TESTS": "on", "FT_INLINE": "on", "FT_VIRTUAL_CHECKOUT": "on", "FT_CULPRITS": "on", "FT_BISECT": "on", "FT_DELETION_GUARD": "on", "FT_TEXT_MERGE": "on", "FT_PUBLIC_MCP": "hono,shortlinks,byo-demo,scale,order-backend,signed-notes,first-red", "FT_GOAL_CONFLICT": "on", "FT_MEGAFILE": "on", "FT_FIELD_GUIDE": "on", "FT_RESOLVER": "on", "FT_AGENT_CALL_BUDGET": "on", "FT_MERGE_INSERTIONS": "on", "FT_MODEL_STEPUP": "on", "FT_TWINS": "on", "FT_QUOTED_ACCEPTANCE": "on", "FT_A2A": "on", "FT_INTENT_SPEND": "on", "FT_HEDGE": "on", "FT_RETURN_HUNKS": "on", "FT_LESSON_SCOPE": "on", "FT_HEADS_UP": "on", "FT_CREDIT_TRAILERS": "on", "FT_REPRODUCE": "on", "FT_ESCALATION_BATCH": "on", "FT_PERSON_WAIT": "on", "FT_ALREADY_ON_TRUNK": "on" },
      "durable_objects": {
        "bindings": [
          { "name": "COLONY", "class_name": "ColonyDO" },
          { "name": "REGION", "class_name": "RegionDO" },
          { "name": "TRUNK", "class_name": "TrunkDO" },
          { "name": "POOL", "class_name": "PoolDO" },
          { "name": "AGENT", "class_name": "AgentDO" },
          { "name": "MCP", "class_name": "FireTridentMcp" },
          { "name": "ACCOUNTS", "class_name": "AccountsDO" },
          { "name": "CF_GRANTS", "class_name": "CloudflareGrantDO" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ColonyDO", "RegionDO", "TrunkDO", "PoolDO", "AgentDO", "FireTridentMcp"] },
        { "tag": "v2", "new_sqlite_classes": ["AccountsDO", "CloudflareGrantDO"] }
      ],
      "artifacts": [
        { "binding": "ARTIFACTS", "namespace": "ft-stg-trunk" },
        { "binding": "WS0", "namespace": "ft-stg-ws-0" },
        { "binding": "WS1", "namespace": "ft-stg-ws-1" },
        { "binding": "WS2", "namespace": "ft-stg-ws-2" },
        { "binding": "WS3", "namespace": "ft-stg-ws-3" },
        { "binding": "SESSIONS", "namespace": "ft-stg-sessions" }
      ],
      "ai": { "binding": "AI" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "worker_loaders": [{ "binding": "LOADER" }],
      "workflows": [
        { "name": "ft-stg-ingest", "binding": "INGEST", "class_name": "IngestWorkflow" },
        { "name": "ft-stg-verify", "binding": "VERIFY", "class_name": "VerifyWorkflow" }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "firetrident_staging_metrics" }],
      "ratelimits": [
        { "name": "PUBLIC_IP_LIMIT", "namespace_id": "41011", "simple": { "limit": 1200, "period": 60 } },
        { "name": "PUBLIC_COLONY_LIMIT", "namespace_id": "41012", "simple": { "limit": 3000, "period": 60 } }
      ]
    }
  },
  "previews": {
    "vars": { "FT_PUBLIC_URL": "https://firetrident.com", "FT_DEFAULT_MODEL": "@cf/moonshotai/kimi-k2.7-code", "FT_BULK_MODEL": "@cf/google/gemma-4-26b-a4b-it", "FT_REFLEX_MODEL": "@cf/cloudflare/clef", "FT_COCHANGE_WEIGHT": "5", "FT_PUBLIC_GIT": "hono,shortlinks,byo-demo", "FT_TRUNK_TESTS": "on" },
    "ai": { "binding": "AI" },
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "worker_loaders": [{ "binding": "LOADER" }],
    "artifacts": [
      { "binding": "ARTIFACTS", "namespace": "ft-trunk" },
      { "binding": "WS0", "namespace": "ft-ws-0" },
      { "binding": "WS1", "namespace": "ft-ws-1" },
      { "binding": "WS2", "namespace": "ft-ws-2" },
      { "binding": "WS3", "namespace": "ft-ws-3" },
      { "binding": "SESSIONS", "namespace": "ft-sessions" }
    ],
    "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "firetrident_metrics" }],
    "durable_objects": {
      "bindings": [
        { "name": "COLONY", "class_name": "ColonyDO" },
        { "name": "REGION", "class_name": "RegionDO" },
        { "name": "TRUNK", "class_name": "TrunkDO" },
        { "name": "POOL", "class_name": "PoolDO" },
        { "name": "AGENT", "class_name": "AgentDO" },
        { "name": "MCP", "class_name": "FireTridentMcp" },
        { "name": "ACCOUNTS", "class_name": "AccountsDO" },
        { "name": "CF_GRANTS", "class_name": "CloudflareGrantDO" }
      ]
    },
    "workflows": [
      { "name": "ft-ingest", "binding": "INGEST", "class_name": "IngestWorkflow" },
      { "name": "ft-verify", "binding": "VERIFY", "class_name": "VerifyWorkflow" }
    ]
  }
}
