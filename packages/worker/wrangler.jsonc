{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "firetrident",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/mcp", "/mcp/*", "/public/mcp", "/sse", "/sse/*", "/healthz", "/git/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "COLONY", "class_name": "ColonyDO" },
      { "name": "REGION", "class_name": "RegionDO" },
      { "name": "TRUNK", "class_name": "TrunkDO" },
      { "name": "POOL", "class_name": "PoolDO" },
      { "name": "AGENT", "class_name": "AgentDO" },
      { "name": "MCP", "class_name": "FireTridentMcp" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ColonyDO", "RegionDO", "TrunkDO", "PoolDO", "AgentDO", "FireTridentMcp"] }
  ],
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "ft-trunk" },
    { "binding": "WS0", "namespace": "ft-ws-0" },
    { "binding": "WS1", "namespace": "ft-ws-1" },
    { "binding": "WS2", "namespace": "ft-ws-2" },
    { "binding": "WS3", "namespace": "ft-ws-3" },
    { "binding": "SESSIONS", "namespace": "ft-sessions" }
  ],
  "ai": { "binding": "AI" },
  "worker_loaders": [{ "binding": "LOADER" }],
  "workflows": [
    { "name": "ft-ingest", "binding": "INGEST", "class_name": "IngestWorkflow" },
    { "name": "ft-verify", "binding": "VERIFY", "class_name": "VerifyWorkflow" }
  ],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "firetrident_metrics" }],
  "vars": { "FT_PUBLIC_URL": "https://firetrident.mattsolt.workers.dev", "FT_DEFAULT_MODEL": "@cf/moonshotai/kimi-k2.7-code", "FT_BULK_MODEL": "@cf/google/gemma-4-26b-a4b-it", "FT_REFLEX_MODEL": "@cf/cloudflare/clef", "FT_COCHANGE_WEIGHT": "5", "FT_PUBLIC_GIT": "hono,shortlinks,byo-demo", "FT_TRUNK_TESTS": "on", "FT_INLINE": "on", "FT_VIRTUAL_CHECKOUT": "on", "FT_CULPRITS": "on", "FT_DELETION_GUARD": "on", "FT_TEXT_MERGE": "on", "FT_PUBLIC_MCP": "hono,shortlinks,byo-demo" },
  "previews": {
    "vars": { "FT_PUBLIC_URL": "https://firetrident.mattsolt.workers.dev", "FT_DEFAULT_MODEL": "@cf/moonshotai/kimi-k2.7-code", "FT_BULK_MODEL": "@cf/google/gemma-4-26b-a4b-it", "FT_REFLEX_MODEL": "@cf/cloudflare/clef", "FT_COCHANGE_WEIGHT": "5", "FT_PUBLIC_GIT": "hono,shortlinks,byo-demo", "FT_TRUNK_TESTS": "on" },
    "ai": { "binding": "AI" },
    "worker_loaders": [{ "binding": "LOADER" }],
    "artifacts": [
      { "binding": "ARTIFACTS", "namespace": "ft-trunk" },
      { "binding": "WS0", "namespace": "ft-ws-0" },
      { "binding": "WS1", "namespace": "ft-ws-1" },
      { "binding": "WS2", "namespace": "ft-ws-2" },
      { "binding": "WS3", "namespace": "ft-ws-3" },
      { "binding": "SESSIONS", "namespace": "ft-sessions" }
    ],
    "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "firetrident_metrics" }],
    "durable_objects": {
      "bindings": [
        { "name": "COLONY", "class_name": "ColonyDO" },
        { "name": "REGION", "class_name": "RegionDO" },
        { "name": "TRUNK", "class_name": "TrunkDO" },
        { "name": "POOL", "class_name": "PoolDO" },
        { "name": "AGENT", "class_name": "AgentDO" },
        { "name": "MCP", "class_name": "FireTridentMcp" }
      ]
    },
    "workflows": [
      { "name": "ft-ingest", "binding": "INGEST", "class_name": "IngestWorkflow" },
      { "name": "ft-verify", "binding": "VERIFY", "class_name": "VerifyWorkflow" }
    ]
  }
}
