{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "firetrident",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/mcp", "/mcp/*", "/sse", "/sse/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "COLONY", "class_name": "ColonyDO" },
      { "name": "REGION", "class_name": "RegionDO" },
      { "name": "TRUNK", "class_name": "TrunkDO" },
      { "name": "POOL", "class_name": "PoolDO" },
      { "name": "AGENT", "class_name": "AgentDO" },
      { "name": "MCP", "class_name": "FireTridentMcp" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ColonyDO", "RegionDO", "TrunkDO", "PoolDO", "AgentDO", "FireTridentMcp"] }
  ],
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "ft-trunk" },
    { "binding": "WS0", "namespace": "ft-ws-0" },
    { "binding": "WS1", "namespace": "ft-ws-1" },
    { "binding": "WS2", "namespace": "ft-ws-2" },
    { "binding": "WS3", "namespace": "ft-ws-3" },
    { "binding": "SESSIONS", "namespace": "ft-sessions" }
  ],
  "ai": { "binding": "AI" },
  "workflows": [
    { "name": "ft-ingest", "binding": "INGEST", "class_name": "IngestWorkflow" },
    { "name": "ft-verify", "binding": "VERIFY", "class_name": "VerifyWorkflow" }
  ],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "firetrident_metrics" }],
  "vars": { "FT_PUBLIC_URL": "https://firetrident.mattsolt.workers.dev", "FT_DEFAULT_MODEL": "@cf/moonshotai/kimi-k2.7-code", "FT_BULK_MODEL": "@cf/zai-org/glm-5.3-flash", "FT_REFLEX_MODEL": "@cf/cloudflare/clef-flash" }
}
